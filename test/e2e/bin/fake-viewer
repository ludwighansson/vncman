#!/usr/bin/env python3
"""Fake VNC viewer for the end-to-end check. Like Remmina, it hands the
connection to a background process and exits at once."""
import os
import socket
import sys
import time

state = os.environ["E2E_STATE"]
with open(os.path.join(state, "viewer-args.log"), "w") as f:
    f.write("\n".join(sys.argv[1:]) + "\n")
host, port = sys.argv[1], int(sys.argv[2])
if os.fork() == 0:
    s = socket.create_connection((host, port))
    greeting = s.recv(12)
    with open(os.path.join(state, "viewer-greeting.log"), "wb") as f:
        f.write(greeting)
    time.sleep(3)
    s.close()
    os._exit(0)
sys.exit(0)
